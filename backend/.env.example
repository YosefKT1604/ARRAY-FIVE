# AI settings for SCDC (read by scdc/ai/config.py). Copy this file to `.env` (git-ignored) and fill it in.
# On Replit, put the same names in Secrets instead. Leave SCDC_AI_PROVIDER=none to run without any model.
SCDC_AI_PROVIDER=none
SCDC_AI_MODEL=anthropic/claude-haiku-5-5
# Optional: a different address, e.g. the base URL of a Replit AI integration.
SCDC_AI_API_BASE=
# Optional: the key. If empty, LiteLLM uses the provider's usual variable (e.g. ANTHROPIC_API_KEY).
SCDC_AI_API_KEY=
SCDC_AI_TIMEOUT_S=20
SCDC_AI_MAX_TOKENS=1500
